---
import Comment from "@components/comment/index.astro";
import Icon from "@components/common/Icon.astro";
import type { BangumiEntry } from "../model/types";
import { getBangumiStatusLabel } from "../model/types";

interface Props {
	entry: BangumiEntry;
	backPath: string;
	backLabel: string;
}
const { entry, backPath, backLabel } = Astro.props;
const placeholderIcon =
	entry.category === "book"
		? "material-symbols:menu-book-outline-rounded"
		: "material-symbols:movie-outline-rounded";
---

<article class="record-detail" data-pagefind-body>
	<a class="record-detail__back" href={backPath}><Icon name="material-symbols:arrow-back-rounded" />{backLabel}</a>
	<header class="record-detail__header">
		<div class="record-detail__cover">
			{entry.image ? <img src={entry.image} alt={`${entry.nameCn || entry.title}封面`} /> : <Icon name={placeholderIcon} class="record-detail__placeholder" />}
		</div>
		<div class="record-detail__intro">
			<p>COLLECTION DETAIL</p>
			<h1 data-pagefind-meta="title">{entry.nameCn || entry.title}</h1>
			{entry.nameCn && entry.nameCn !== entry.title && <span>{entry.title}</span>}
			<div class="record-detail__badges">
				<strong>{getBangumiStatusLabel(entry.category, entry.status)}</strong>
				{entry.score !== undefined && <strong>{entry.score.toFixed(1)} / 10</strong>}
				{entry.tags.map((tag) => <span>#{tag}</span>)}
			</div>
			{entry.comment && <blockquote>{entry.comment}</blockquote>}
		</div>
	</header>
	<div class="record-detail__content custom-md"><slot /></div>
</article>

<Comment customPath={entry.link} />

<style>
	.record-detail { display: grid; gap: 1.5rem; }
	.record-detail__back { display: inline-flex; align-items: center; gap: 0.375rem; width: fit-content; color: var(--content-meta); text-decoration: none; }
	.record-detail__back:hover { color: var(--primary); }
	.record-detail__header { display: grid; grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
	.record-detail__cover { display: grid; place-items: center; aspect-ratio: 3 / 4; overflow: hidden; border: 1px solid var(--line-divider); border-radius: 0.5rem; background: var(--btn-regular-bg); color: var(--content-meta); }
	.record-detail__cover img { width: 100%; height: 100%; object-fit: cover; }
	.record-detail__placeholder { width: 4rem; height: 4rem; }
	.record-detail__intro { display: grid; gap: 0.75rem; }
	.record-detail__intro > p { margin: 0; color: var(--content-meta); font: 700 0.6875rem/1.2 ui-monospace, monospace; }
	.record-detail__intro h1 { margin: 0; color: var(--deep-text); font-size: 2rem; line-height: 1.15; }
	.record-detail__intro > span { color: var(--content-meta); }
	.record-detail__badges { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.record-detail__badges > * { padding: 0.25rem 0.5rem; border: 1px solid var(--line-divider); border-radius: 0.25rem; color: var(--content-meta); font-size: 0.75rem; }
	.record-detail__badges strong { border-color: color-mix(in oklch, var(--primary) 45%, var(--line-divider)); color: var(--primary); }
	.record-detail blockquote { margin: 0; padding: 0.75rem 1rem; border-left: 3px solid var(--primary); background: color-mix(in oklch, var(--primary) 7%, transparent); color: var(--deep-text); }
	.record-detail__content { padding-top: 1rem; border-top: 1px solid var(--line-divider); }
	@media (max-width: 640px) { .record-detail__header { grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; } .record-detail__intro h1 { font-size: 1.4rem; } }
</style>
