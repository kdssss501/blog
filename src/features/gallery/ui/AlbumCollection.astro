---
import type { CollectionEntry } from "astro:content";
import Icon from "@components/common/Icon.astro";

interface Props {
	albums: CollectionEntry<"album">[];
}

const { albums } = Astro.props;
const sortedAlbums = [...albums].sort(
	(left, right) => right.data.date.getTime() - left.data.date.getTime(),
);
const totalPhotos = sortedAlbums.reduce(
	(total, album) => total + album.data.photos.length,
	0,
);
const formatMonth = (date: Date) =>
	`${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}`;
const dateRange = sortedAlbums.length
	? `${formatMonth(sortedAlbums.at(-1)?.data.date ?? new Date())} - ${formatMonth(sortedAlbums[0].data.date)}`
	: "暂无记录";
const photoSource = (photo: string | { src: string }) =>
	typeof photo === "string" ? photo : photo.src;
---

<section class="album-collection" data-pagefind-body>
	<a href="/moments/" class="album-collection__back">
		<Icon name="material-symbols:arrow-left-rounded" />
		返回动态
	</a>
	<header class="album-collection__header">
		<div class="album-collection__masthead">
			<div class="album-collection__title">
				<span><Icon name="material-symbols:photo-library-outline-rounded" /></span>
				<div><p>PHOTO ARCHIVE</p><h1 data-pagefind-meta="title">我的相册</h1><small>记录生活中的美好瞬间</small></div>
			</div>
			<a class="album-collection__crawler" href="/album/crawler/" data-pagefind-ignore>
				<Icon name="material-symbols:travel-explore-rounded" />
				<span><small>LOCAL TOOL</small><strong>Pixiv 素材采集</strong></span>
				<Icon name="material-symbols:arrow-forward-rounded" />
			</a>
		</div>
		<div class="album-collection__stats">
			<span><Icon name="material-symbols:photo-album-outline-rounded" /><strong>{sortedAlbums.length}</strong> 相册</span>
			<span><Icon name="material-symbols:imagesmode-outline-rounded" /><strong>{totalPhotos}</strong> 照片</span>
			<span><Icon name="material-symbols:calendar-month-outline-rounded" />{dateRange}</span>
		</div>
	</header>

	{sortedAlbums.length ? (
		<div class="album-collection__grid">
			{sortedAlbums.map((album, index) => {
				const safePhotos = album.data.photos.filter(
					(photo) => typeof photo === "string" || !photo.sensitive,
				);
				const sensitivePhotos = album.data.photos.filter(
					(photo) => typeof photo !== "string" && photo.sensitive,
				);
				const previews = [...safePhotos, ...sensitivePhotos].slice(0, 3);
				const albumHref = `/album/${album.id}/`;
				const hasCinematicPrologue = album.id === "04-fate";
				return (
					<article class="collection-album-card-shell" style={`--delay:${index * 70}ms`}>
						<a class="collection-album-card" href={albumHref}>
							<div class="collection-album-card__stack">
								{previews.map((photo, photoIndex) => (
									<figure class={`collection-album-card__photo is-${photoIndex + 1}`}>
										<img src={photoSource(photo)} alt="" loading="lazy" decoding="async" />
									</figure>
								))}
								{previews.length === 0 && <Icon name="material-symbols:add-photo-alternate-outline-rounded" />}
								{album.data.photos.length > 3 && <b>+{album.data.photos.length - 3}</b>}
							</div>
							<div class="collection-album-card__body">
								<h2>{album.data.title}</h2>
								<p>{album.data.subtitle}</p>
								<div><span>{album.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long" })}</span><span>{album.data.photos.length} 张</span></div>
							</div>
						</a>
						{hasCinematicPrologue && (
							<button
								type="button"
								class="collection-album-card__cinematic"
								data-cinematic-trigger
								data-cinematic-clip="saber-prologue"
								data-cinematic-mode="navigate"
								data-cinematic-href={albumHref}
								aria-label="播放 Fate 电影序章并进入相册"
								title="播放电影序章"
							>
								<Icon name="material-symbols:movie-outline-rounded" />
							</button>
						)}
					</article>
				);
			})}
		</div>
	) : (
		<div class="album-collection__empty"><Icon name="material-symbols:photo-album-outline-rounded" /><strong>还没有创建相册</strong><span>在内容目录添加相册文件后会自动显示。</span></div>
	)}
</section>

<style>
	.album-collection { display:grid; gap:2rem; }
	.album-collection__back { display:inline-flex; width:fit-content; align-items:center; gap:.4rem; color:var(--content-meta); text-decoration:none; }
	.album-collection__back:hover { color:var(--primary); }
	.album-collection__header { display:grid; gap:1rem; }
	.album-collection__masthead { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
	.album-collection__title { display:flex; align-items:center; gap:.85rem; }
	.album-collection__title > span { display:grid; width:3rem; height:3rem; place-items:center; border-radius:.8rem; background:var(--primary); color:#fff; font-size:1.45rem; }
	.album-collection__title p { margin:0 0 .2rem; color:var(--content-meta); font:700 .67rem/1 ui-monospace,monospace; }
	.album-collection__title h1 { margin:0; color:var(--deep-text); font-size:2rem; }
	.album-collection__title small { color:var(--content-meta); }
	.album-collection__crawler { display:grid; min-width:13rem; grid-template-columns:auto 1fr auto; align-items:center; gap:.6rem; padding:.65rem .75rem; border:1px solid var(--deep-text); border-radius:.4rem; color:var(--deep-text); text-decoration:none; transition:background-color .18s ease,color .18s ease,transform .18s ease; }
	.album-collection__crawler > svg:first-child { color:var(--primary); font-size:1.3rem; }
	.album-collection__crawler span { display:grid; gap:.12rem; }
	.album-collection__crawler small { color:var(--content-meta); font:700 .55rem/1 ui-monospace,monospace; }
	.album-collection__crawler strong { font-size:.74rem; }
	.album-collection__crawler:hover { background:var(--deep-text); color:var(--page-bg); transform:translateY(-1px); }
	.album-collection__crawler:hover :is(small,svg) { color:inherit; }
	.album-collection__stats { display:flex; flex-wrap:wrap; gap:.55rem; }
	.album-collection__stats span { display:inline-flex; min-height:2rem; align-items:center; gap:.35rem; padding:.35rem .7rem; border:1px solid var(--line-divider); border-radius:999px; color:var(--content-meta); font-size:.75rem; }
	.album-collection__stats strong { color:var(--deep-text); }
	.album-collection__grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; }
	.collection-album-card-shell { position:relative; min-width:0; margin:0; animation:album-enter .45s both; animation-delay:var(--delay); }
	.collection-album-card { display:block; min-width:0; padding:.6rem; border:2px dashed var(--line-divider); border-radius:1.15rem; color:inherit; text-decoration:none; transition:border-color .2s ease,transform .2s ease; }
	.collection-album-card:hover { border-color:var(--deep-text); transform:translateY(-2px); }
	.collection-album-card__cinematic { position:absolute; top:1rem; right:1rem; z-index:7; display:grid; width:2.75rem; height:2.75rem; place-items:center; padding:0; border:1px solid rgb(255 255 255 / 72%); border-radius:50%; background:rgb(0 0 0 / 62%); color:#fff; font-size:1.3rem; cursor:pointer; box-shadow:0 .3rem 1rem rgb(0 0 0 / 24%); transition:background-color .18s ease,transform .18s ease; }
	.collection-album-card__cinematic:hover,.collection-album-card__cinematic:focus-visible { background:#111; outline:2px solid #fff; outline-offset:2px; transform:scale(1.06); }
	.collection-album-card__stack { position:relative; display:grid; height:13rem; place-items:center; }
	.collection-album-card__stack > svg { width:3rem; color:var(--content-meta); }
	.collection-album-card__stack b { position:absolute; right:1.1rem; bottom:1rem; z-index:5; padding:.25rem .55rem; border-radius:999px; background:rgb(0 0 0 / 72%); color:#fff; font-size:.68rem; }
	.collection-album-card__photo { position:absolute; width:68%; height:82%; margin:0; padding:.35rem; border:1px solid var(--line-divider); border-radius:.2rem; background:var(--card-bg); box-shadow:0 .4rem 1.2rem rgb(0 0 0 / 12%); transition:transform .3s ease; }
	.collection-album-card__photo img { width:100%; height:100%; object-fit:cover; }
	.collection-album-card__photo.is-1 { z-index:3; transform:translate(9%,-1%) rotate(6deg); }
	.collection-album-card__photo.is-2 { z-index:2; transform:translate(-7%,3%) rotate(1deg); }
	.collection-album-card__photo.is-3 { z-index:1; transform:translate(-16%,5%) rotate(-6deg); }
	.collection-album-card:hover .is-1 { transform:translate(16%,-5%) rotate(10deg); }
	.collection-album-card:hover .is-2 { transform:translate(-2%,-7%) rotate(0); }
	.collection-album-card:hover .is-3 { transform:translate(-24%,1%) rotate(-10deg); }
	.collection-album-card__body { padding:.35rem .45rem .8rem; }
	.collection-album-card__body h2 { margin:0; color:var(--deep-text); font-size:1rem; }
	.collection-album-card__body p { min-height:1.2em; margin:.3rem 0; color:var(--content-meta); font-size:.78rem; }
	.collection-album-card__body div { display:flex; justify-content:space-between; color:var(--content-meta); font-size:.7rem; }
	.collection-album-card:hover h2 { color:var(--primary); }
	.album-collection__empty { display:grid; min-height:18rem; place-items:center; align-content:center; gap:.45rem; border:1px dashed var(--line-divider); color:var(--content-meta); }
	.album-collection__empty svg { width:3rem; }
	.album-collection__empty strong { color:var(--deep-text); }
	@keyframes album-enter { from { opacity:0; transform:translateY(.5rem); } }
	@media (max-width:900px) { .album-collection__grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
	@media (max-width:600px) { .album-collection__masthead { align-items:stretch; flex-direction:column; } .album-collection__crawler { width:100%; } .album-collection__grid { grid-template-columns:1fr; } .collection-album-card__stack { height:15rem; } }
	@media (prefers-reduced-motion:reduce) { .collection-album-card-shell,.collection-album-card,.collection-album-card__photo,.collection-album-card__cinematic { animation:none; transition:none; } }
</style>
