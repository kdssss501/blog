---
import Icon from "@components/common/Icon.astro";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { homeConfig } from "@/config/homeConfig";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/features/posts/server";
import { url } from "@/utils/url-utils";

const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
const bio = Array.isArray(homeConfig.bio) ? homeConfig.bio[0] : homeConfig.bio;
---

<section class="profile-card">
	<div class="profile-card__cover">
		<img src={homeConfig.hero.backgroundImage} alt="" loading="eager" />
	</div>
	<a class="profile-card__avatar" href={url("/about/")} aria-label="查看关于页面">
		<ImageWrapper
			src={homeConfig.avatar || ""}
			alt={`${homeConfig.displayName || homeConfig.name} 的头像`}
			class="w-full h-full"
			loading="eager"
			fetchpriority="high"
			widths={[160]}
			sizes="80px"
		/>
	</a>
	<div class="profile-card__body">
		<h2>{homeConfig.displayName || homeConfig.name}</h2>
		<p>{bio || "记录学习与生活的点滴"}</p>
		<nav aria-label="个人链接">
			{homeConfig.links.map((link) => (
				<a href={link.url} aria-label={link.name} title={link.name} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}>
					<Icon name={link.icon} />
				</a>
			))}
		</nav>
		<div class="profile-card__stats">
			<a href="/posts/"><strong>{posts.length}</strong><span>文章</span></a>
			<a href="/categories/"><strong>{categories.length}</strong><span>分类</span></a>
			<a href="/archive/"><strong>{tags.length}</strong><span>标签</span></a>
		</div>
	</div>
</section>

<style>
	.profile-card {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line-divider);
		border-radius: 8px;
		background: var(--card-bg);
		box-shadow: 0 3px 12px rgb(0 0 0 / 5%);
	}

	.profile-card__cover {
		height: 6.5rem;
		overflow: hidden;
		background: var(--btn-regular-bg);
	}

	.profile-card__cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.profile-card__avatar {
		position: absolute;
		top: 4.2rem;
		left: 50%;
		display: block;
		width: 4.6rem;
		height: 4.6rem;
		overflow: hidden;
		border: 4px solid var(--card-bg);
		border-radius: 50%;
		background: var(--card-bg);
		transform: translateX(-50%);
	}

	.profile-card__avatar :global(img) {
		object-fit: contain;
		transform-origin: 50% 72%;
		will-change: translate, rotate, scale;
		animation: profile-roxy-idle 6.4s ease-in-out infinite;
		transition: scale 280ms ease;
	}

	.profile-card__avatar:hover :global(img) {
		scale: 1.04;
	}

	@keyframes profile-roxy-idle {
		0%, 100% {
			translate: 0 0;
			rotate: 0deg;
		}
		50% {
			translate: 0 -1.5%;
			rotate: 0.3deg;
		}
	}

	.profile-card__body {
		padding: 2.75rem 1rem 1rem;
		text-align: center;
	}

	@media (prefers-reduced-motion: reduce) {
		.profile-card__avatar :global(img) {
			animation: none;
			transition: none;
			translate: 0;
			rotate: 0deg;
			scale: 1;
		}

		.profile-card__avatar:hover :global(img) {
			scale: 1;
		}
	}

	.profile-card__body h2 {
		margin: 0;
		color: var(--deep-text);
		font-size: 1rem;
		font-weight: 900;
	}

	.profile-card__body > p {
		margin: 0.4rem 0 0;
		color: var(--content-meta);
		font-size: 0.72rem;
		line-height: 1.5;
	}

	.profile-card__body nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 0.8rem;
	}

	.profile-card__body nav a {
		display: grid;
		width: 1.9rem;
		height: 1.9rem;
		place-items: center;
		border-radius: 5px;
		color: var(--content-meta);
	}

	.profile-card__body nav a:hover,
	.profile-card__body nav a:focus-visible {
		background: var(--btn-regular-bg);
		color: var(--deep-text);
	}

	.profile-card__stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 0.9rem;
		padding-top: 0.85rem;
		border-top: 1px solid var(--line-divider);
	}

	.profile-card__stats a {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		color: var(--deep-text);
		text-decoration: none;
	}

	.profile-card__stats a + a {
		border-left: 1px solid var(--line-divider);
	}

	.profile-card__stats strong {
		font-size: 0.85rem;
	}

	.profile-card__stats span {
		color: var(--content-meta);
		font-size: 0.62rem;
	}
</style>
