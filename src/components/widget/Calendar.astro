---
import Icon from "@components/common/Icon.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { getSortedPosts } from "@/features/posts/server";
import { getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
const posts = (await getSortedPosts()).map((post) => ({
	title: post.data.title,
	url: getPostUrlBySlug(post.id),
	published: post.data.published.getTime(),
}));
const calendarPayload = JSON.stringify(posts).replace(/</g, "\\u003c");
---

<WidgetLayout id="calendar-widget" class={className} style={style}>
	<sidebar-calendar class="sidebar-calendar">
		<header class="sidebar-calendar__header">
			<button type="button" data-calendar-prev aria-label="上个月">
				<Icon name="material-symbols:chevron-left-rounded" />
			</button>
			<button type="button" class="sidebar-calendar__month" data-calendar-today>本月</button>
			<button type="button" data-calendar-next aria-label="下个月">
				<Icon name="material-symbols:chevron-right-rounded" />
			</button>
		</header>
		<div class="sidebar-calendar__week" aria-hidden="true">
			<span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
		</div>
		<div class="sidebar-calendar__grid" data-calendar-grid aria-live="polite"></div>
		<div class="sidebar-calendar__divider"></div>
		<nav class="sidebar-calendar__posts" data-calendar-posts-list aria-label="本月近期内容"></nav>
		<script is:inline type="application/json" data-calendar-posts set:html={calendarPayload}></script>
	</sidebar-calendar>
</WidgetLayout>

<script>
	type CalendarPost = { title: string; url: string; published: number };

	class SidebarCalendar extends HTMLElement {
		private posts: CalendarPost[] = [];
		private displayDate = new Date();
		private selectedDate = "";

		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";
			const data = this.querySelector<HTMLScriptElement>("[data-calendar-posts]");
			try {
				this.posts = JSON.parse(data?.textContent || "[]") as CalendarPost[];
			} catch {
				this.posts = [];
			}
			this.querySelector("[data-calendar-prev]")?.addEventListener("click", () =>
				this.changeMonth(-1),
			);
			this.querySelector("[data-calendar-next]")?.addEventListener("click", () =>
				this.changeMonth(1),
			);
			this.querySelector("[data-calendar-today]")?.addEventListener("click", () => {
				this.displayDate = new Date();
				this.selectedDate = "";
				this.render();
			});
			this.render();
		}

		private changeMonth(delta: number) {
			this.displayDate = new Date(
				this.displayDate.getFullYear(),
				this.displayDate.getMonth() + delta,
				1,
			);
			this.selectedDate = "";
			this.render();
		}

		private dateKey(date: Date) {
			return [
				date.getFullYear(),
				String(date.getMonth() + 1).padStart(2, "0"),
				String(date.getDate()).padStart(2, "0"),
			].join("-");
		}

		private postsForMonth() {
			const year = this.displayDate.getFullYear();
			const month = this.displayDate.getMonth();
			return this.posts.filter((post) => {
				const date = new Date(post.published);
				return date.getFullYear() === year && date.getMonth() === month;
			});
		}

		private render() {
			const year = this.displayDate.getFullYear();
			const month = this.displayDate.getMonth();
			const monthButton = this.querySelector<HTMLElement>("[data-calendar-today]");
			if (monthButton) monthButton.textContent = `${year}年${month + 1}月`;

			const monthlyPosts = this.postsForMonth();
			const postDates = new Map<string, number>();
			for (const post of monthlyPosts) {
				const key = this.dateKey(new Date(post.published));
				postDates.set(key, (postDates.get(key) || 0) + 1);
			}
			this.renderDays(postDates);
			const visiblePosts = this.selectedDate
				? monthlyPosts.filter(
						(post) => this.dateKey(new Date(post.published)) === this.selectedDate,
					)
				: monthlyPosts;
			this.renderPosts(visiblePosts);
		}

		private renderDays(postDates: Map<string, number>) {
			const grid = this.querySelector<HTMLElement>("[data-calendar-grid]");
			if (!grid) return;
			const year = this.displayDate.getFullYear();
			const month = this.displayDate.getMonth();
			const todayKey = this.dateKey(new Date());
			const firstWeekday = new Date(year, month, 1).getDay();
			const dayCount = new Date(year, month + 1, 0).getDate();
			const fragment = document.createDocumentFragment();
			for (let index = 0; index < firstWeekday; index += 1) {
				const blank = document.createElement("span");
				blank.className = "sidebar-calendar__blank";
				fragment.append(blank);
			}
			for (let day = 1; day <= dayCount; day += 1) {
				const date = new Date(year, month, day);
				const key = this.dateKey(date);
				const count = postDates.get(key) || 0;
				const button = document.createElement("button");
				button.type = "button";
				button.className = "sidebar-calendar__day";
				button.textContent = String(day);
				button.dataset.hasPosts = String(count > 0);
				button.classList.toggle("is-today", key === todayKey);
				button.classList.toggle("is-selected", key === this.selectedDate);
				button.title = count > 0 ? `${key} · ${count} 条内容` : key;
				if (count > 0) {
					const dot = document.createElement("span");
					dot.className = "sidebar-calendar__dot";
					button.append(dot);
					button.addEventListener("click", () => {
						this.selectedDate = this.selectedDate === key ? "" : key;
						this.render();
					});
				}
				fragment.append(button);
			}
			grid.replaceChildren(fragment);
		}

		private renderPosts(posts: CalendarPost[]) {
			const list = this.querySelector<HTMLElement>("[data-calendar-posts-list]");
			if (!list) return;
			const fragment = document.createDocumentFragment();
			for (const post of posts.slice(0, 6)) {
				const date = new Date(post.published);
				const link = document.createElement("a");
				link.href = post.url;
				const title = document.createElement("span");
				title.textContent = post.title;
				const time = document.createElement("time");
				time.dateTime = date.toISOString();
				time.textContent = `${date.getMonth() + 1}-${date.getDate()}`;
				link.append(title, time);
				fragment.append(link);
			}
			if (fragment.childNodes.length === 0) {
				const empty = document.createElement("p");
				empty.className = "sidebar-calendar__empty";
				empty.textContent = "这个月还没有更新";
				fragment.append(empty);
			}
			list.replaceChildren(fragment);
		}
	}

	if (!customElements.get("sidebar-calendar")) {
		customElements.define("sidebar-calendar", SidebarCalendar);
	}
</script>

<style is:global>
	.sidebar-calendar { display:block; color:var(--deep-text); }
	.sidebar-calendar__header { display:grid; grid-template-columns:2rem 1fr 2rem; align-items:center; margin-bottom:.65rem; }
	.sidebar-calendar__header button { display:grid; min-width:0; height:2rem; place-items:center; border:0; background:transparent; color:inherit; font:inherit; cursor:pointer; }
	.sidebar-calendar__header button:hover,
	.sidebar-calendar__header button:focus-visible { color:var(--primary); }
	.sidebar-calendar__month { font-size:1.02rem !important; font-weight:950 !important; }
	.sidebar-calendar__week,
	.sidebar-calendar__grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:.16rem; }
	.sidebar-calendar__week { margin-bottom:.3rem; color:var(--content-meta); font-size:.64rem; text-align:center; }
	.sidebar-calendar__week span { padding:.15rem 0; }
	.sidebar-calendar__day,
	.sidebar-calendar__blank { position:relative; aspect-ratio:1; min-width:0; }
	.sidebar-calendar__day { display:grid; place-items:center; border:1px solid transparent; border-radius:5px; background:transparent; color:var(--deep-text); font:inherit; font-size:.75rem; font-weight:700; cursor:default; }
	.sidebar-calendar__day[data-has-posts="true"] { font-weight:950; cursor:pointer; }
	.sidebar-calendar__day[data-has-posts="true"]:hover,
	.sidebar-calendar__day.is-selected { background:var(--btn-regular-bg); color:var(--primary); }
	.sidebar-calendar__day.is-today { border-color:var(--deep-text); }
	.sidebar-calendar__dot { position:absolute; bottom:.14rem; left:50%; width:.2rem; height:.2rem; border-radius:50%; background:var(--primary); transform:translateX(-50%); }
	.sidebar-calendar__divider { height:1px; margin:.8rem 0 .55rem; background:var(--line-divider); }
	.sidebar-calendar__posts { display:grid; gap:.08rem; }
	.sidebar-calendar__posts a { display:grid; min-width:0; grid-template-columns:minmax(0,1fr) auto; gap:.45rem; padding:.28rem .25rem; border-radius:4px; color:var(--content-text); font-size:.7rem; text-decoration:none; }
	.sidebar-calendar__posts a:hover,
	.sidebar-calendar__posts a:focus-visible { background:var(--btn-regular-bg); color:var(--primary); }
	.sidebar-calendar__posts span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	.sidebar-calendar__posts time { color:var(--content-meta); font-size:.64rem; white-space:nowrap; }
	.sidebar-calendar__empty { margin:.35rem 0; color:var(--content-meta); font-size:.68rem; text-align:center; }
</style>
