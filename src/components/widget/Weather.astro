---
import Icon from "@components/common/Icon.astro";
import WidgetLayout from "@components/common/WidgetLayout.astro";

const today = new Intl.DateTimeFormat("zh-CN", {
	month: "long",
	day: "numeric",
	weekday: "short",
}).format(new Date());
---

<WidgetLayout id="weather-widget" name="天气预报">
	<div class="weather-widget">
		<Icon name="material-symbols:partly-cloudy-day-outline-rounded" />
		<strong>{today}</strong>
		<span>愿今天也有好天气</span>
	</div>
</WidgetLayout>

<style>
	.weather-widget { display:grid; grid-template-columns:2.75rem 1fr; align-items:center; gap:.15rem .75rem; min-height:5rem; }
	.weather-widget > svg { grid-row:1 / 3; width:2.5rem; height:2.5rem; color:var(--primary); }
	.weather-widget strong { color:var(--deep-text); font-size:1.15rem; }
	.weather-widget span { color:var(--content-meta); font-size:.75rem; }
</style>
