---
import Announcement from "@components/widget/Announcement.astro";
import Calendar from "@components/widget/Calendar.astro";
import Categories from "@components/widget/Categories.astro";
import HotRanking from "@components/widget/HotRanking.astro";
import JourneyCounter from "@components/widget/JourneyCounter.astro";
import Music from "@components/widget/Music.astro";
import PostDirectory from "@components/widget/PostDirectory.astro";
import Profile from "@components/widget/Profile.astro";
import Quote from "@components/widget/Quote.astro";
import RecentPosts from "@components/widget/RecentPosts.astro";
import SidebarTOC from "@components/widget/SidebarTOC.astro";
import SiteStats from "@components/widget/SiteStats.astro";
import Tags from "@components/widget/Tags.astro";
import Weather from "@components/widget/Weather.astro";
import { sidebarLayoutConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";

export type SidebarVariant = "default" | "posts" | "social";

interface Props {
	side: "left" | "right" | "mobile";
	isPostPage?: boolean;
	variant?: SidebarVariant;
}

const { side, isPostPage = false, variant = "default" } = Astro.props;
const configured: WidgetComponentConfig[] =
	side === "mobile"
		? sidebarLayoutConfig.mobileBottomComponents.map((component) => ({
				...component,
				position: "top",
			}))
		: side === "left"
			? sidebarLayoutConfig.leftComponents
			: sidebarLayoutConfig.rightComponents;
const visible = configured.filter(
	(component) =>
		component.enable &&
		(!component.variants || component.variants.includes(variant)) &&
		(isPostPage
			? component.showOnPostPage !== false
			: component.showOnNonPostPage !== false),
);
const topComponents = visible.filter(
	(component) => component.position !== "sticky",
);
const stickyComponents = visible.filter(
	(component) => component.position === "sticky",
);

const componentMap = {
	profile: Profile,
	announcement: Announcement,
	music: Music,
	categories: Categories,
	tags: Tags,
	calendar: Calendar,
	stats: SiteStats,
	sidebarToc: SidebarTOC,
	weather: Weather,
	journey: JourneyCounter,
	recentPosts: RecentPosts,
	quote: Quote,
	hotRanking: HotRanking,
	postDirectory: PostDirectory,
};
const sidebarId =
	side === "mobile"
		? "mobile-sidebar"
		: side === "left"
			? "left-sidebar"
			: "right-sidebar";
---

<aside id={sidebarId} class:list={["sidebar", `${side}-sidebar`, { "mobile-sidebar": side === "mobile" }]}>
	{topComponents.map((component) => {
		const Component = componentMap[component.type as keyof typeof componentMap];
		return Component ? <Component /> : null;
	})}
	{stickyComponents.length > 0 && (
		<div class="sidebar-sticky-group">
			{stickyComponents.map((component) => {
				const Component = componentMap[component.type as keyof typeof componentMap];
				return Component ? <Component /> : null;
			})}
		</div>
	)}
</aside>

<style>
	.sidebar { display:flex; width:100%; min-width:0; flex-direction:column; gap:1rem; }
	.sidebar-sticky-group { position:sticky; top:5.25rem; display:grid; gap:1rem; }
	.mobile-sidebar { display:none; }
	@media (max-width:768px) {
		.sidebar:not(.mobile-sidebar) { display:none !important; }
		.mobile-sidebar { display:grid; margin-top:2rem; }
		.mobile-sidebar .sidebar-sticky-group { position:static; }
	}
</style>
