---
import Icon from "@components/common/Icon.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	id: string;
	name?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	useExpandedButtonSpacing?: boolean;
	class?: string;
	style?: string;
}

const {
	id,
	name,
	isCollapsed = false,
	collapsedHeight,
	useExpandedButtonSpacing = false,
	style,
} = Astro.props;
const className = Astro.props.class;
---

<widget-layout
	data-id={id}
	data-is-collapsed={String(isCollapsed)}
	data-use-expanded-button-spacing={String(useExpandedButtonSpacing)}
	class:list={["widget-card", className]}
	style={`--collapsed-height: ${collapsedHeight || "0"}; ${style || ""}`}
>
	{name && (
		<header class="widget-card__header">
			<h2>{name}</h2>
			<slot name="title-icon" />
		</header>
	)}
	<div id={id} class:list={["widget-card__content", { collapsed: isCollapsed }] }>
		<slot />
	</div>
	{isCollapsed && (
		<div class="widget-card__expand">
			<button
				type="button"
				title={i18n(I18nKey.more)}
				aria-label={i18n(I18nKey.more)}
				data-show-more={i18n(I18nKey.more)}
				data-show-less={i18n(I18nKey.collapse)}
				data-expanded="false"
			>
				<Icon name="material-symbols:more-horiz" class="toggle-icon-more" />
				<Icon name="material-symbols:keyboard-arrow-up-rounded" class="toggle-icon-less hidden" />
				<span class="toggle-text">{i18n(I18nKey.more)}</span>
			</button>
		</div>
	)}
</widget-layout>

<script>
	class WidgetLayoutElement extends HTMLElement {
		connectedCallback() {
			if (this.dataset.isCollapsed !== "true" || this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";
			const id = this.dataset.id;
			const button = this.querySelector<HTMLButtonElement>(".widget-card__expand button");
			const wrapper = id ? this.querySelector<HTMLElement>(`#${CSS.escape(id)}`) : null;
			if (!button || !wrapper) return;

			button.addEventListener("click", () => {
				const expanded = button.dataset.expanded === "true";
				const nextExpanded = !expanded;
				button.dataset.expanded = String(nextExpanded);
				wrapper.classList.toggle("collapsed", !nextExpanded);
				const label = nextExpanded ? button.dataset.showLess || "" : button.dataset.showMore || "";
				button.title = label;
				button.setAttribute("aria-label", label);
				const text = button.querySelector(".toggle-text");
				if (text) text.textContent = label;
				button.querySelector(".toggle-icon-more")?.classList.toggle("hidden", nextExpanded);
				button.querySelector(".toggle-icon-less")?.classList.toggle("hidden", !nextExpanded);
			});
		}
	}

	if (!customElements.get("widget-layout")) {
		customElements.define("widget-layout", WidgetLayoutElement);
	}
</script>
