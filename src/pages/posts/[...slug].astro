---
import { render } from "astro:content";
import KatexManager from "@components/features/KatexManager.astro";
import type { ImageMetadata } from "astro";
import { PostArticle } from "@/features/posts";
import {
	getPostPagePresentation,
	getSortedPosts,
} from "@/features/posts/server";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { removeFileExtension } from "@/utils/url-utils";

export async function getStaticPaths() {
	return (await getSortedPosts()).map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const imageFiles = import.meta.glob<ImageMetadata>("../../**", {
	import: "default",
});
const presentation = await getPostPagePresentation(
	entry,
	imageFiles,
	Astro.url.href,
	Astro.site,
);
const words = Number(remarkPluginFrontmatter.words ?? 0);
const minutes = Number(remarkPluginFrontmatter.minutes ?? 0);
const bannerPostMeta = {
	title: entry.data.title,
	published: entry.data.published,
	updated: entry.data.updated,
	words,
	minutes,
};
---

<MainGridLayout
	banner={presentation.processedImage}
	title={entry.data.title}
	description={entry.data.description}
	lang={entry.data.lang}
	setOGTypeArticle={true}
	postSlug={entry.id}
	postCategory={entry.data.category || undefined}
	showSidebar={false}
	catalogGroups={presentation.catalogGroups}
	{bannerPostMeta}
>
	<KatexManager slot="head" />
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(presentation.jsonLd)} />
	<PostArticle
		{entry}
		{Content}
		{words}
		{minutes}
		processedImage={presentation.processedImage}
		apiUrls={presentation.apiUrls}
		imageAttribution={presentation.imageAttribution}
		posterCoverUrl={presentation.posterCoverUrl}
		posterAvatarUrl={presentation.posterAvatarUrl}
		posterUrl={Astro.url.href}
	/>
</MainGridLayout>
