---
import PageTitle from "@/components/common/PageTitle.astro";
import { collectionsApiConfig, siteConfig } from "@/config";
import {
	CollectionsDirectory,
	normalizeCollectionGroups,
} from "@/features/collections";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.collections) return Astro.redirect("/404/");

const title = collectionsApiConfig.title || i18n(I18nKey.collections);
const description =
	collectionsApiConfig.description || i18n(I18nKey.collectionsDescription);
const enabledGroups = normalizeCollectionGroups(
	collectionsApiConfig.apis,
	collectionsApiConfig.categories,
);
---

<MainGridLayout title={title} description={description}>
	<section class="collections-page" aria-labelledby="collections-page-title">
		<header class="collections-page__header">
			<PageTitle title={title} eyebrow="Collections" variant="stacked" />
			{description && <p>{description}</p>}
		</header>
		<CollectionsDirectory groups={enabledGroups} emptyLabel={i18n(I18nKey.collectionsEmpty)} />
	</section>
</MainGridLayout>
