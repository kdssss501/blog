---
import { getCollection, getEntry } from "astro:content";
import Comment from "@components/comment/index.astro";
import Icon from "@components/common/Icon.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import { FriendDirectory, FriendRulesModal } from "@/features/friends";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.friends) return Astro.redirect("/404/");

const friendsPost = await getEntry("spec", "friends");
if (!friendsPost) throw new Error("friends page content not found");

const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;
const importedFriends = (await getCollection("friends"))
	.filter((entry) => entry.data.enabled)
	.map((entry) => entry.data);
const items = [
	...getEnabledFriends(),
	...importedFriends.filter(
		(imported) =>
			!getEnabledFriends().some(
				(existing) => existing.siteurl === imported.siteurl,
			),
	),
];
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description} showSidebar={true} sidebarVariant="social">
	<section class="friends-page" aria-labelledby="friends-page-title">
		<header class="friends-page-header">
			<div>
				<PageTitle title={title} />
				{description && <p class="friends-page-description">{description}</p>}
			</div>
			{friendsPageConfig.applyLink && (
				<button type="button" data-open-friend-rules class="friends-apply-button">
					<Icon name="material-symbols:help-outline-rounded" />
					<span>如何申请友链</span>
				</button>
			)}
		</header>

		<FriendDirectory items={items} pageSize={items.length || 1} allLabel={i18n(I18nKey.all)} />
	</section>

	{isCommentEnabled && (
		<section class="friends-comments" aria-label="友链评论">
			<Comment post={friendsPost} customPath="/friends/" />
		</section>
	)}

	<FriendRulesModal applyLink={friendsPageConfig.applyLink} />
</MainGridLayout>
