---
import { siteConfig, sponsorConfig } from "@/config";
import { SponsorContent } from "@/features/sponsor";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.sponsor) return Astro.redirect("/404/");

const title = sponsorConfig.title || i18n(I18nKey.sponsorTitle);
const description =
	sponsorConfig.description || i18n(I18nKey.sponsorDescription);
---

<MainGridLayout title={title} description={description}>
	<SponsorContent
		title={title}
		description={description}
		usage={sponsorConfig.usage}
		methods={sponsorConfig.methods.filter((method) => method.enabled)}
		sponsors={sponsorConfig.sponsors ?? []}
		showSponsorsList={sponsorConfig.showSponsorsList !== false}
		scanLabel={i18n(I18nKey.scanToSponsor)}
		emptyLabel={i18n(I18nKey.sponsorEmpty)}
	/>
</MainGridLayout>
