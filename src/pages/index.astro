---
import {
	HomeDataLayer,
	HomeDisplayLayer,
	HomeHero,
	HomePhotoDeck,
	HomeTicker,
} from "@/features/home";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout>
	<div class="home-page home-page--motion-pending">
		<HomeHero />
		<HomeDisplayLayer />
		<HomeTicker />
		<HomePhotoDeck />
		<HomeDataLayer />
	</div>
</MainGridLayout>

<script is:inline>
	(() => {
		const revealPendingHome = () => {
			window.setTimeout(() => {
				document
					.querySelectorAll(".home-page--motion-pending, .home-hero--motion-pending")
					.forEach((element) => {
						element.classList.remove(
							"home-page--motion-pending",
							"home-hero--motion-pending",
						);
					});
			}, 2400);
		};

		revealPendingHome();
		if (document.documentElement.dataset.homeMotionFallback !== "ready") {
			document.documentElement.dataset.homeMotionFallback = "ready";
			document.addEventListener("astro:page-load", revealPendingHome);
			document.addEventListener("swup:contentReplaced", revealPendingHome);
		}
	})();
</script>
