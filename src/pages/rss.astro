---
import { getSortedPosts } from "@/features/posts/server";
import { RssDirectory, type RssRecentPost } from "@/features/rss";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

const title = i18n(I18nKey.rss);
const description = i18n(I18nKey.rssDescription);
const feedUrl = new URL("rss.xml", Astro.site ?? Astro.url.origin).href;
const recentPosts: RssRecentPost[] = (await getSortedPosts())
	.slice(0, 6)
	.map((post) => ({
		id: post.id,
		title: post.data.title,
		url: getPostUrlBySlug(post.id),
		description: post.data.description,
		publishedIso: post.data.published.toISOString(),
		publishedText: formatDateToYYYYMMDD(post.data.published),
	}));
---

<MainGridLayout {title} {description}>
	<RssDirectory {feedUrl} {recentPosts} />
</MainGridLayout>
