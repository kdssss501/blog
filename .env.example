# ── Cloudflare 凭证（必填） ──────────────────────────

# API Token：用于构建脚本上传向量到 Vectorize
# 获取方式：
#   1. 登录 https://dash.cloudflare.com
#   2. 右上角头像 → My Profile → API Tokens → Create Token
#   3. 选择「Custom token」，权限勾选：
#      - Account > Vectorize > Edit
#      - Account > Workers AI > Use
#   4. 创建后复制 Token（只显示一次）
CLOUDFLARE_API_TOKEN=your_token_here

# Account ID：Cloudflare 账户唯一标识
# 获取方式：
#   1. 登录 https://dash.cloudflare.com
#   2. 任意域名概览页 → 右侧栏「API」区域 → Account ID
#   3. 或直接从 URL 中复制：https://dash.cloudflare.com/<account_id>/...
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# ── DeepSeek 官方聊天 API（可选） ────────────────────

# DeepSeek 官方 API Key：仅用于对话，不会发送到浏览器，也不用于 Embedding
# 获取地址：https://platform.deepseek.com/api_keys
# 博客向量检索是独立能力，需要 Cloudflare Workers AI + Vectorize；未配置时对话仍可用
AI_API_KEY=your_api_key_here

# 允许调用 Worker AI 接口的站点来源，多个来源用英文逗号分隔
ALLOWED_ORIGINS=https://your-domain.example

# ── 本地 GPT-SoVITS 公网网关（可选） ────────────────
# Vercel 只保存 Tunnel 地址和服务 Token；浏览器永远不会收到 Token。
# Quick Tunnel 地址每次重启都会变化，正式部署应改用固定域名 Tunnel。
TTS_UPSTREAM_URL=https://your-tts-gateway.example
TTS_SERVICE_TOKEN=replace_with_at_least_32_random_characters
# 本地网关默认仅监听 127.0.0.1:8788。
TTS_GATEWAY_PORT=8788
TTS_GATEWAY_MAX_PENDING=3
# 可选：项目本地 cloudflared 默认位于 .tools/cloudflared.exe。
CLOUDFLARED_PATH=

# ── 管理接口（生产环境必填） ─────────────────────────

# 统一管理后台 Token：用于 /write/、/config/、朋友圈刷新，并换取两小时签名会话。
BLOG_ADMIN_TOKEN=replace_with_a_long_random_admin_token

# 笔记本创建、编辑和删除接口使用的 Bearer Token。
# 请生成高强度随机值，并在 Cloudflare Pages / Vercel 环境变量中配置。
NOTEBOOK_ADMIN_TOKEN=replace_with_a_long_random_token

# 动态创建、编辑和删除接口使用的 Bearer Token。
ACTIVITY_ADMIN_TOKEN=replace_with_a_different_long_random_token

# ── GitHub 文章发布（可选） ───────────────────────────

# 未配置时草稿和预览仍可用，发布接口会返回 503。
GITHUB_CONTENT_TOKEN=github_fine_grained_token
GITHUB_REPOSITORY=owner/repository
GITHUB_BRANCH=main

# ─── Content assets (optional) ───────────────────────────────────────────────
# Local development writes uploaded images to public/uploads/content automatically.
# Cloudflare Pages: bind an R2 bucket named CONTENT_ASSETS in wrangler.toml, then
# configure the public/custom-domain prefix used to read those objects.
CONTENT_ASSET_PUBLIC_BASE_URL=https://assets.your-domain.example
# Alternative: a storage gateway that accepts POST image bytes and returns
# JSON in the form {"url":"https://..."}. Keep its token only in the host env.
CONTENT_ASSET_EXTERNAL_UPLOAD_URL=
CONTENT_ASSET_EXTERNAL_TOKEN=
# Optional AMap JS API credentials for the /life/places map.
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_SECURITY_CODE=

# ─── Vampire Live2D / SoulLink (optional) ───────────────────────────────────
# Local development only. The Vite proxy reads the purchased model in place;
# it never copies the source model or its four 8192 textures into public/.
VAMPIRE_LIVE2D_SOURCE_DIR=

# Production requires a separately authorized asset host and a legally hosted
# Cubism 5 Core URL. Leave both blank to show the explicit static fallback.
PUBLIC_VAMPIRE_MODEL_URL=
PUBLIC_CUBISM_CORE_URL=
